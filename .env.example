# AWS S3 Font Storage (server-side only, used by prebuild script)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# Solana RPC (server-side only, never exposed to the browser).
# Public Solana RPCs reject browser calls and rate-limit hard; set your private/paid RPC here.
# Used by /api/solana-rpc (delivery status of TC -> Solana messages) and the Solana warp
# balance route. Falls back to the registry's public RPCs when unset.
SOLANA_RPC_URL=https://your-private-solana-rpc.example.com/?api-key=...
# Optional, same idea for solanatestnet
# SOLANA_TESTNET_RPC_URL=

# Terra Classic registry (defaults already point to the fork / branch public-warp)
# NEXT_PUBLIC_REGISTRY_URL=https://github.com/terra-classic-hyperlane/hyperlane-registry
# NEXT_PUBLIC_REGISTRY_BRANCH=public-warp
